<?xml version="1.0" encoding="utf-8"?>
<!-- 通知 smallIcon：白色镂空矢量图 24×24dp，纯白无背景。
     状态栏小图标只能用这种白色镂空图，彩色启动图标会被系统压成灰方块，
     这就是 v1.3 之前“状态栏图标异常”的根因。切勿改成彩色图标。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- “A” + 下划线：翻译符号，描边纯白 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,18 L12,5 L18,18 M8.5,14 L15.5,14" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M5,21.5 H19" />
</vector>
