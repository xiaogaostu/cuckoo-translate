<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FloatingTranslate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorPrimaryDark">@color/purple_700</item>
        <item name="android:colorAccent">@color/teal_200</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- v1.6.2：翻译小面板的对话框主题。面板是真正的 Activity，不是悬浮窗：
         windowIsFloating 让它成为浮在聊天界面上方的半透明小卡片（不是全屏），
         背后微暗，点外面可关闭；窗口大小由代码按 300dp / 半屏高再定。 -->
    <style name="Theme.FloatingTranslate.Panel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorPrimaryDark">@color/purple_700</item>
        <item name="android:colorAccent">@color/teal_200</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
