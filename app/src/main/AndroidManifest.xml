<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮球：必须（唯一需要的敏感权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 翻译接口联网：必须 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台 Service 保活悬浮球 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 前台 Service 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 复制到剪贴板（无需单独声明，保留说明） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- v1.4.0：已砍掉自动识别翻译，不再声明 BIND_ACCESSIBILITY_SERVICE，
         不再注册 TranslationAccessibilityService，不读其他 App 的内容。 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloatingTranslate"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FloatingTranslate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 翻译小面板（v1.6.2）：真正的半透明 Activity，对话框式小卡片。
             不加悬浮窗权限、不读无障碍。单独的 taskAffinity：面板关掉后
             回到聊天 App，不会回到 Cuckoo 主界面；excludeFromRecents
             不进最近任务；singleTop：球再点一次发 onNewIntent，可开关面板。 -->
        <activity
            android:name=".TranslatePanelActivity"
            android:exported="false"
            android:theme="@style/Theme.FloatingTranslate.Panel"
            android:launchMode="singleTop"
            android:taskAffinity="com.floatingtranslate.app.panel"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 悬浮球前台 Service -->
        <service
            android:name=".FloatingBallService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
